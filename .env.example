# ══════════════════════════════════════════════════════════════
#   Ciber-Shield — Variables de entorno
#   Copiar a .env y completar con tus valores
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── Aplicación ─────────────────────────────────────────────────
APP_NAME="Ciber-Shield"
DEBUG=false
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

# ── Base de datos ──────────────────────────────────────────────
# SQLite (por defecto, sin configuración)
DATABASE_URL=sqlite:///data/ciber_shield.db

# PostgreSQL (producción)
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/ciber_shield

# ── NVD API (National Vulnerability Database) ─────────────────
# Sin key: 5 peticiones/30s   Con key: 50 peticiones/30s
# Obtener key gratuita: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── Scanner ────────────────────────────────────────────────────
SCANNER_TIMEOUT=1           # Timeout por puerto en segundos
SCANNER_MAX_THREADS=150     # Hilos concurrentes máximos
DEFAULT_PORT_RANGE=1-1024   # Rango de puertos por defecto

# ── Web ────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ── Informes ───────────────────────────────────────────────────
REPORTS_DIR=reports
